---
import "../styles.css";

interface Props {
  title: string;
  // Lay the page out to fit one screen on desktop, with no page scroll.
  fit?: boolean;
}
const { title, fit = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500&family=Source+Serif+4:wght@400;600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={{ "fit-screen": fit }}>
    <header class="site-header">
      <a href="/" class="wordmark">
        <img class="logo-mark" src="/logo.webp" alt="" width="37" height="40" />
        The Dig
      </a>
      <nav aria-label="Main">
        <a href="/">Excavation</a>
        <a href="/archive">Archive</a>
        <a href="/readme/">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
