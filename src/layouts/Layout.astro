---
import "../styles.css";
import Mascot from "../components/Mascot.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Poppins:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="wordmark">
        <Mascot class="mascot" />
        The Dig
      </a>
      <nav aria-label="Main">
        <a href="/">Excavation</a>
        <a href="/archive">Archive</a>
        <a href="/readme/">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
