---
import Layout from "../layouts/Layout.astro";
import { openSite } from "../lib/dig";
import { trayFor } from "../lib/specimens";
import { gridRef } from "../sites";
import { getOrCreateVisitor } from "../lib/visitor";

const { visitor } = getOrCreateVisitor(Astro.cookies);
const { id: siteId } = openSite();
const tray = trayFor(visitor.id, siteId);
---

<Layout title="Your archive, The Dig">
  <h1>Your specimen tray</h1>
  <p>Finds you've collected from the current dig, {visitor.name}.</p>

  {
    tray.length === 0 ? (
      <p class="flash" role="status">
        Nothing in your tray yet, drag a recovered find here from the excavation, or use its
        <strong>+</strong> button.
      </p>
    ) : (
      <ul class="specimen-grid">
        {tray.map(({ row, col, cell }) => (
          <li class="specimen-card">
            <span class="specimen-ref">{gridRef(row, col)}</span>
            <a class={`fragment kind-${cell.kind}`} href={`/section/${row}-${col}`} set:html={cell.html} />
            <form method="post" action="/api/archive">
              <input type="hidden" name="cell" value={`${row}-${col}`} />
              <input type="hidden" name="action" value="remove" />
              <button type="submit">Remove</button>
            </form>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
