---
// Publishes README.md verbatim, rendered. spec/invariants.test.ts checks its
// headings show up here, in order.
import Layout from "../layouts/Layout.astro";
import Stamp from "../components/Stamp.astro";
import * as readme from "../../README.md";

const html = await readme.compiledContent();
---

<Layout title="About, The Dig">
  <article class="dossier deckle-edge readme-content">
    <Stamp>About this dig</Stamp>
    <div set:html={html} />
  </article>
</Layout>
