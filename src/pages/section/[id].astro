---
import Layout from "../../layouts/Layout.astro";
import Stamp from "../../components/Stamp.astro";
import { cellAt, gridRef } from "../../sites";
import { findings, openSite } from "../../lib/dig";

const key = Astro.params.id ?? "";
const [row, col] = key.split("-").map(Number);
const { id: siteId, site } = openSite();
const finding = findings(siteId).get(key);
const cell = cellAt(site, row, col);

// A section's content is never sent until it's brushed, so an un-brushed
// (or never-dug) section's note stays buried too.
if (!finding || !finding.brushedAt || !cell) return new Response("Not found", { status: 404 });

const when = new Date(finding.dugAt).toLocaleString("en-AU", {
  timeZone: "Australia/Sydney",
  dateStyle: "medium",
  timeStyle: "short",
});
const brushedWhen = new Date(finding.brushedAt).toLocaleString("en-AU", {
  timeZone: "Australia/Sydney",
  dateStyle: "medium",
  timeStyle: "short",
});
---

<Layout title={`Section ${row + 1}·${col + 1}, The Dig`}>
  <p><a href={`/#cell-${key}`} data-back-to-dig>← Back to the dig</a></p>
  <article class="note-card deckle-edge">
    <Stamp>Specimen {gridRef(row, col)}</Stamp>
    <h1>Row {row + 1}, column {col + 1}</h1>
    <div class="fragment" set:html={cell.html} />
    <h2>Field note</h2>
    <p>{cell.note}</p>
    <p data-finder>Uncovered by <strong>{finding.finder}</strong> on {when}.</p>
    {
      finding.brusher && (
        <p data-brusher>Brushed clean by <strong>{finding.brusher}</strong> on {brushedWhen}.</p>
      )
    }
  </article>
  <script>
    // Coming from the dig, going back in history returns to the exact scroll
    // position the visitor left; following the link would instead jump the
    // tile to the top of the window.
    const back = document.querySelector<HTMLAnchorElement>("[data-back-to-dig]");
    back?.addEventListener("click", (e) => {
      const from = document.referrer ? new URL(document.referrer) : null;
      if (from?.origin === location.origin && from.pathname === "/" && history.length > 1) {
        e.preventDefault();
        history.back();
      }
    });
  </script>
</Layout>
