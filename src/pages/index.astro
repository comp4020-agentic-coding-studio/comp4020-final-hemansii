---
import Layout from "../layouts/Layout.astro";
import IsoSite from "../components/IsoSite.astro";
import { COLS, ROWS, cellAt, colLabel, gridRef } from "../sites";
import { DIGS_PER_DAY, closedSites, digAllowance, digsToday, findings, nextReset, openSite } from "../lib/dig";
import { listNotes } from "../lib/notes";
import { MAX_EVIDENCE, listTheories } from "../lib/theories";
import { KIND_LABELS, trayFor } from "../lib/specimens";
import { getOrCreateVisitor } from "../lib/visitor";
import { recentActivity } from "../lib/activity";
import { nextDigCost } from "../lib/shop";
import { questionFor, triviaStatus } from "../lib/trivia";
import { currentlyHere } from "../lib/events";
import { markSeen, sinceLastVisit } from "../lib/away";
import { untilLabel } from "../lib/countdown";

const { visitor, isNew } = getOrCreateVisitor(Astro.cookies);
const here = currentlyHere();
const { id: siteId, site, number } = openSite();
// Read before marking this visit, or there'd never be a gap to report.
// The live layer's own fetches of / carry a header saying so, since those
// aren't the player coming back.
const isResync = Astro.request.headers.get("x-dig-resync") === "1";
const away = isNew || isResync ? null : sinceLastVisit(visitor.id, visitor.lastSeenAt, siteId);
if (!isResync) markSeen(visitor.id);
const plural = (n: number, one: string, many: string): string => `${n} ${n === 1 ? one : many}`;
const awayLines = away
  ? [
      away.uncovered > 0 &&
        `${plural(away.uncovered, "section", "sections")} uncovered${away.diggers > 1 ? ` by ${away.diggers} diggers` : ""}`,
      away.brushed > 0 && `${plural(away.brushed, "find", "finds")} brushed clean`,
      away.theories > 0 && `${plural(away.theories, "new theory", "new theories")}`,
      away.notes > 0 && `${plural(away.notes, "field note", "field notes")}`,
    ].filter((line): line is string => Boolean(line))
  : [];
const awaySince = away
  ? new Date(away.since).toLocaleString("en-AU", { timeZone: "Australia/Sydney", weekday: "short", hour: "numeric", minute: "2-digit" })
  : "";
const past = closedSites(5);
const lastDig = past[0];
const found = findings(siteId);
const allowance = digAllowance(visitor.id);
const left = Math.max(0, allowance - digsToday(visitor.id));
// When free digs come back, from the same day boundary the cap is counted
// on. Sent as an instant, so the page counts down to it without a clock of
// its own deciding when a day ends.
const resetAt = nextReset();
const resetIn = untilLabel(resetAt.getTime());
const tray = trayFor(visitor.id, siteId);
const saved = new Set(tray.map(({ row, col }) => `${row}-${col}`));
const notes = listNotes(siteId);
const theories = listTheories(siteId);
const activity = recentActivity(siteId, 14);
const latestTheory = theories[0];
const digCost = nextDigCost(visitor.id);
const trivia = triviaStatus(visitor.id);
const question = questionFor();

const MESSAGES: Record<string, string> = {
  ok: "You felt something underneath, brush away the dust to see what it is.",
  "out-of-digs": `You've used today's ${DIGS_PER_DAY} digs. Your free digs reset in ${resetIn}.`,
  "already-dug": "Someone got to that section first.",
  "out-of-range": "That isn't part of the dig site.",
  brushed: "You brushed it clean. Have a look.",
  "already-brushed": "Someone already brushed that clean.",
  "nothing-there": "There's nothing dug up there yet.",
  "name-set": "Name updated.",
  "note-ok": "Field note posted.",
  "theory-ok": "Theory posted.",
  "theory-needs-evidence": "Correct guess, but cite a recovered clue to solve the site.",
  solved: "You named it! A new website has been buried. Start digging.",
  archived: "Added to your specimen tray.",
  unarchived: "Removed from your specimen tray.",
  "archive-bad-cell": "That section isn't yours to collect yet.",
  "buy-ok": "Bought a bonus dig. Back to the grid.",
  "buy-not-enough-shards": "Not enough shards for another dig.",
  "buy-digs-not-exhausted": "Use today's free digs before buying more.",
  "trivia-correct": "Correct! Shards earned, come back tomorrow for another streak day.",
  "trivia-wrong": "Not quite. Come back tomorrow for a fresh question.",
  "trivia-already-answered": "Already answered today's question.",
  "no-connection": "Couldn't reach the dig. Check your connection and try again.",
};
const flash = MESSAGES[Astro.url.searchParams.get("r") ?? ""];

// How far each section has been dug down: 0 turf, 1 dug, 2 brushed clean.
// A hole shows a soil wall on a far edge (north, west) only where the
// neighbour is shallower, and a lip of turf on any edge that meets turf, so
// two holes side by side read as one trench. Past the plot's far edges is
// the boundary trench; past its near edges, the block's turf margin.
const depth = (row: number, col: number): number => {
  const f = found.get(`${row}-${col}`);
  return !f ? 0 : f.brushedAt ? 2 : 1;
};
const onPlot = (row: number, col: number): boolean => row >= 0 && row < ROWS && col >= 0 && col < COLS;
const isTurf = (row: number, col: number): boolean => onPlot(row, col) && depth(row, col) === 0;
const edges = (row: number, col: number): string | undefined => {
  const d = depth(row, col);
  if (d === 0) return undefined;
  const v = {
    wn: Math.max(0, d - depth(row - 1, col)),
    ww: Math.max(0, d - depth(row, col - 1)),
    ln: isTurf(row - 1, col) ? 1 : 0,
    lw: isTurf(row, col - 1) ? 1 : 0,
    ls: !onPlot(row + 1, col) || isTurf(row + 1, col) ? 1 : 0,
    le: !onPlot(row, col + 1) || isTurf(row, col + 1) ? 1 : 0,
  };
  return Object.entries(v).map(([k, n]) => `--${k}: ${n}`).join("; ");
};
---

<Layout title="The Dig" fit>
  <div class="expedition-bar">
    <div class="expedition-title">
      <h1>A famous 2000s website is buried here</h1>
      <p>
        Dig a section to find it, brush it to read it, and be the first to name the site in a theory. Name it and the
        next one gets buried. {DIGS_PER_DAY} digs a day each.
      </p>
    </div>
    <ul class="status" aria-live="polite">
      <li class="whoami">
        <details>
          <summary>You are <strong>{visitor.name}</strong> <span class="whoami-edit">change</span></summary>
          <form method="post" action="/api/visitor" class="rename-inline">
            <label for="rename-inline" class="visually-hidden">Your name on the dig</label>
            <input id="rename-inline" name="name" maxlength="40" value={visitor.name} autocomplete="off" />
            <button type="submit">Save</button>
          </form>
        </details>
      </li>
      <li class="stat" data-digs-left={left} data-reset-at={resetAt.toISOString()}>
        <strong>{left}</strong> <span>of {allowance} digs left today{left === 0 && <span class="dig-reset">, more in <span data-reset-in>{resetIn}</span></span>}</span>
      </li>
      <li class="stat" data-recovered={found.size}><strong>{found.size}</strong> / {ROWS * COLS} sections recovered</li>
      <li class="stat" id="tray-count"><a href="/archive">🧺 <strong>{tray.length}</strong> in your tray</a></li>
      <li class="stat" data-shards={visitor.shards}>💎 <strong>{visitor.shards}</strong> shards</li>
      <li class="buy-dig" id="buy-dig-slot" hidden={left > 0} data-cost={digCost}>
        <form method="post" action="/api/shop">
          <button type="submit" disabled={visitor.shards < digCost}>
            Buy a dig for {digCost} 💎
          </button>
        </form>
      </li>
      <li class="here-now" id="here-count" data-here={here}>
        <span class="here-dot" aria-hidden="true"></span>
        <strong>{here}</strong> <span id="here-word">{here === 1 ? "person" : "people"}</span><span id="here-tail"> digging right now</span>
      </li>
    </ul>
  </div>

  {
    isNew && (
      <form method="post" action="/api/visitor" class="rename-banner">
        <label for="name">
          New here? You're <strong>{visitor.name}</strong> for now, or pick your own name:
        </label>
        <div class="rename-row">
          <input id="name" name="name" maxlength="40" value={visitor.name} autocomplete="off" />
          <button type="submit">Start digging as this name</button>
        </div>
      </form>
    )
  }

  {
    away && (
      <section class="since-away" id="since-away" aria-labelledby="since-away-title">
        <div class="since-away-text">
          <h2 id="since-away-title">Since you last dug <span class="since-away-when">({awaySince})</span></h2>
          {away.solved && (
            <p class="since-away-solved" data-away-solved>
              {away.solved.by ? <><strong>{away.solved.by}</strong> named the last site: {away.solved.title}.</> : <>The last site, {away.solved.title}, was brushed clean unsolved.</>}{" "}
              A new one is buried.
            </p>
          )}
          {awayLines.length > 0 && (
            <ul class="since-away-list">
              {awayLines.map((line) => <li>{line}</li>)}
            </ul>
          )}
        </div>
        <button type="button" class="since-away-close" id="since-away-close" aria-label="Dismiss what changed since your last visit">Got it</button>
      </section>
    )
  }

  <p class="flash" role="status" id="flash" hidden={!flash}>{flash}</p>
  <div class="out-of-digs" id="out-of-digs" role="dialog" aria-labelledby="ood-title" aria-describedby="ood-body" hidden>
    <p class="ood-title" id="ood-title">You've used today's {DIGS_PER_DAY} digs</p>
    <p class="ood-body" id="ood-body">
      <span class="ood-reset">Your free digs reset in <strong id="ood-reset">{resetIn}</strong>.</span>
      You have <strong id="ood-shards">0</strong> 💎. <span id="ood-detail"></span>
    </p>
    <div class="ood-actions">
      <form method="post" action="/api/shop" id="ood-buy">
        <button type="submit" id="ood-buy-button">Buy a dig</button>
      </form>
      <button type="button" class="ood-close" id="ood-close">Not now</button>
    </div>
  </div>
  <div class="notices" id="notices" aria-live="polite" aria-label="New from other players"></div>
  <p class="live-banner" id="live-banner" role="status" hidden></p>
  <script type="application/json" id="flash-messages" set:html={JSON.stringify(MESSAGES)} />

  <form method="post" action="/api/dig" id="dig-form" class="visually-hidden" aria-hidden="true"></form>

  <div class="excavation-layout">
    <div class="dig-pane">
      <ol class="how-to" id="how-to" aria-label="How to dig">
        <li data-step="dig"><span class="how-to-chip"><span class="how-to-icon how-to-dig" aria-hidden="true"></span><span class="how-to-text"><span class="verb-touch">Tap</span><span class="verb-pointer">Click</span> to dig</span></span></li>
        <li data-step="brush"><span class="how-to-chip"><span class="how-to-icon how-to-brush" aria-hidden="true"></span><span class="how-to-text"><span class="verb-touch">Tap</span><span class="verb-pointer">Click</span> again to brush</span></span></li>
        <li data-step="save"><span class="how-to-chip"><span class="how-to-icon how-to-save" aria-hidden="true"></span><span class="how-to-text"><span class="verb-touch">Tap a clue to save</span><span class="verb-pointer">Press + on a clue to save it</span></span></span></li>
      </ol>
      <div class="dig-viewport" id="dig-viewport">
      <p class="pan-hint" id="pan-hint" aria-hidden="true" hidden>Drag to explore the dig site</p>
      <span class="edge-fade edge-left" aria-hidden="true"></span>
      <span class="edge-fade edge-right" aria-hidden="true"></span>
      <span class="edge-fade edge-top" aria-hidden="true"></span>
      <span class="edge-fade edge-bottom" aria-hidden="true"></span>
      <div class="iso-field" id="iso-field">
      <div class="iso-stage">
        <IsoSite layer="under" class="iso-under" />
      <fieldset class="grid iso-plane" id="dig-grid">
        <legend class="visually-hidden">Dig site</legend>
        {Array.from({ length: COLS }, (_, col) => (
          <span class="iso-label" aria-hidden="true" style={`--x: ${col + 0.5}; --y: -0.6`}>{colLabel(col)}</span>
        ))}
        {Array.from({ length: ROWS }, (_, row) => (
          <span class="iso-label" aria-hidden="true" style={`--x: -0.6; --y: ${row + 0.5}`}>{row + 1}</span>
        ))}
        {
          Array.from({ length: ROWS }, (_, row) =>
            Array.from({ length: COLS }, (_, col) => {
              const key = `${row}-${col}`;
              const finding = found.get(key);
              const cell = cellAt(site, row, col);
              if (finding?.brushedAt && cell) {
                const isSaved = saved.has(key);
                return (
                  <div class="find" data-saved={isSaved ? "" : undefined}>
                    <a
                      class="cell"
                      href={`/section/${key}`}
                      id={`cell-${key}`}
                      data-cell={key}
                      data-state="revealed"
                      style={edges(row, col)}
                      title={`${gridRef(row, col)}: uncovered by ${finding.finder}${finding.brusher ? `, brushed clean by ${finding.brusher}` : ""}`}
                      draggable="true"
                    ><span class="iso-face" data-kind={cell.kind} set:html={cell.html} /></a>
                    <span class="grid-tag" aria-hidden="true">{gridRef(row, col)}</span>
                    {isSaved ? (
                      <span class="tray-saved" title="In your specimen tray">
                        <span aria-hidden="true">✓</span>
                        <span class="visually-hidden">Row {row + 1}, column {col + 1} is in your tray</span>
                      </span>
                    ) : (
                      <form method="post" action="/api/archive" class="tray-add">
                        <input type="hidden" name="cell" value={key} />
                        <input type="hidden" name="action" value="add" />
                        <button type="submit" title="Add to specimen tray" aria-label={`Add row ${row + 1}, column ${col + 1} to your tray`}>+</button>
                      </form>
                    )}
                  </div>
                );
              }
              if (finding) {
                return (
                  <button
                    class="cell dusty"
                    name="cell"
                    value={key}
                    id={`cell-${key}`}
                    data-cell={key}
                    data-state="dusty"
                    style={edges(row, col)}
                    title={`${gridRef(row, col)}: uncovered by ${finding.finder}, waiting for a brush`}
                    formaction="/api/brush"
                    form="dig-form"
                    aria-label={`Brush row ${row + 1}, column ${col + 1}`}
                  ><span class="brush-cue" aria-hidden="true"></span></button>
                );
              }
              return (
                <button
                  class="cell"
                  name="cell"
                  value={key}
                  id={`cell-${key}`}
                  data-cell={key}
                  data-state="buried"
                  data-spent={left === 0 ? "" : undefined}
                  form="dig-form"
                  aria-label={`Dig row ${row + 1}, column ${col + 1}`}
                />
              );
            }),
          )
        }
      </fieldset>
        <IsoSite layer="over" class="iso-over" />
      </div>
      </div>
      </div>
    </div>

    <aside class="field-pane">
    <section class="mystery" id="mystery" aria-labelledby="mystery-heading">
      <img class="mystery-art" src="/props/soil-cube.webp" alt="" width="58" height="68" />
      <p class="mystery-kicker">Dig site #{number}</p>
      <h2 id="mystery-heading">Which famous website is this?</h2>
      <div id="mystery-latest" class="mystery-latest" data-site={siteId}>
        {
          lastDig && (
            <p class="mystery-last" data-last-solved={lastDig.solvedBy ? `${lastDig.solvedBy} named the last one: ${lastDig.title}` : `The last one was ${lastDig.title}, brushed clean unsolved`}>
              Last dig: <strong>{lastDig.title}</strong> ({lastDig.year}),{" "}
              {lastDig.solvedBy ? <>named by <strong>{lastDig.solvedBy}</strong>.</> : "brushed clean, nobody named it."}
            </p>
          )
        }
        {
          latestTheory ? (
            <p>
              <span class="mystery-count">{theories.length} {theories.length === 1 ? "theory" : "theories"} so far.</span>{" "}
              Latest, from <strong>{latestTheory.author}</strong>: <q>{latestTheory.body}</q>
            </p>
          ) : (
            <p>No guesses yet. Read the recovered fragments and name the site.</p>
          )
        }
      </div>
      <form method="post" action="/api/theories" class="mystery-form">
        <input type="hidden" name="from" value="mystery" />
        {/* The quick box has no picker, so it cites the tray's first finds
            for the player (kept in step with the tray by the live layer).
            The server still keeps only finds really in their tray. */}
        <span id="mystery-evidence" hidden>
          {tray.slice(0, MAX_EVIDENCE).map(({ row, col }) => <input type="hidden" name="evidence" value={`${row}-${col}`} />)}
        </span>
        <label for="mystery-body" class="visually-hidden">Your theory about the buried site</label>
        <input id="mystery-body" name="body" maxlength="300" placeholder="I think it was…" autocomplete="off" required />
        <button type="submit">Log my theory</button>
      </form>
    </section>

      <input type="radio" name="field-tab" id="tab-tray" class="visually-hidden" checked />
      <input type="radio" name="field-tab" id="tab-notes" class="visually-hidden" />
      <input type="radio" name="field-tab" id="tab-theories" class="visually-hidden" />
      <div class="tab-bar" role="tablist" aria-label="Field pane">
        <label for="tab-tray" class="tab-label">Tray</label>
        <label for="tab-notes" class="tab-label">Field notes <span class="tab-badge" data-badge="notes" hidden></span></label>
        <label for="tab-theories" class="tab-label">Theories <span class="tab-badge" data-badge="theories" hidden></span></label>
      </div>

      <section class="panel tab-panel" id="tray" aria-labelledby="tray-heading">
        <h2 id="tray-heading"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18l-2 3H5L3 6Z"/><path d="M4 6v1a8 8 0 0 0 16 0V6"/><path d="M12 10v8"/></svg> Specimen tray</h2>
        <div id="tray-drop" class="tray-drop" data-tray-drop>
          <div id="tray-contents">
          {
            tray.length === 0 ? (
              <p class="tray-empty">
                <img class="empty-art" src="/props/specimen-tray.webp" alt="" width="72" height="49" />
                <span class="hint-pointer">Drag a recovered find here to add it to your tray, or use its <strong>+</strong> button.</span>
                <span class="hint-touch">Tap a recovered find on the dig site to add it to your tray.</span>
              </p>
            ) : (
              <ul class="tray-items" id="tray-list">
                {tray.map(({ row, col, cell, finder, note }) => (
                  <li class="tray-tag" data-key={`${row}-${col}`}>
                    <span class="tray-tag-ref">{gridRef(row, col)}</span>
                    <div class="tray-tag-body">
                      <a href={`/section/${row}-${col}`} class="tray-tag-fragment" data-kind={cell.kind} set:html={cell.html} />
                      <p class="tray-tag-meta">{KIND_LABELS[cell.kind] ?? cell.kind} · found by {finder}</p>
                      {note && <p class="tray-tag-note">{note}</p>}
                    </div>
                    <form method="post" action="/api/archive">
                      <input type="hidden" name="cell" value={`${row}-${col}`} />
                      <input type="hidden" name="action" value="remove" />
                      <button type="submit" aria-label={`Remove ${gridRef(row, col)} from your tray`}>×</button>
                    </form>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        </div>
        {tray.length > 0 && <a href="/archive" class="panel-link">Lay them out on the evidence table →</a>}
      </section>

      <section class="panel tab-panel" id="notes" aria-labelledby="notes-heading">
        <h2 id="notes-heading"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10Z"/></svg> Field notes</h2>
        <form method="post" action="/api/notes" class="feed-form">
          <label for="note-body" class="visually-hidden">Leave a field note</label>
          <textarea id="note-body" name="body" maxlength="300" rows="2" placeholder="The text in row 4 looks like a sidebar, try next to it…" required></textarea>
          <button type="submit">Post note</button>
        </form>
        <ul class="feed" id="notes-list">
          {
            notes.length === 0 && (
              <li class="feed-empty">
                <img class="empty-art" src="/props/field-notebook.webp" alt="" width="64" height="51" />
                No notes yet. Tell the others where to dig or what you spotted.
              </li>
            )
          }
          {notes.map((n) => (
            <li class="feed-item note-item" data-id={n.id} data-author={n.author} data-mine={n.authorId === visitor.id ? "" : undefined}>
              <p>{n.body}</p>
              <p class="feed-meta"><strong>{n.author}</strong></p>
            </li>
          ))}
        </ul>
      </section>

      <section class="panel tab-panel" id="theories" aria-labelledby="theories-heading">
        <h2 id="theories-heading"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.2 1 2.3h6c0-1.1.4-1.8 1-2.3A7 7 0 0 0 12 2Z"/></svg> Theories</h2>
        <form method="post" action="/api/theories" class="feed-form theory-form">
          <label for="theory-body" class="visually-hidden">Submit a theory</label>
          <textarea id="theory-body" name="body" maxlength="300" rows="2" placeholder="I think this was…" required></textarea>
          <fieldset class="evidence-pick" id="evidence-pick" data-max={MAX_EVIDENCE}>
            <legend>Evidence from your tray <span>(up to {MAX_EVIDENCE}, needed to solve)</span></legend>
            {tray.length === 0 && <p class="evidence-none">Save finds to your tray to cite them here. A theory needs one to solve the site.</p>}
            {tray.map(({ row, col, cell }) => (
              <label class="evidence-chip" title={cell.html.replace(/<[^>]+>/g, "")}>
                <input type="checkbox" name="evidence" value={`${row}-${col}`} />
                <span class="specimen-tag">{gridRef(row, col)}</span>
              </label>
            ))}
          </fieldset>
          <button type="submit">Post theory</button>
        </form>
        <ul class="feed" id="theories-list">
          {
            theories.length === 0 && (
              <li class="feed-empty">
                <img class="empty-art" src="/props/flag.webp" alt="" width="34" height="52" />
                No theories yet. Which website was this?
              </li>
            )
          }
          {theories.map((t) => (
            <li class="feed-item theory-item" data-id={t.id} data-author={t.author} data-mine={t.authorId === visitor.id ? "" : undefined}>
              <p>{t.body}</p>
              {t.evidence.length > 0 && (
                <p class="theory-evidence">
                  <span>Evidence</span>
                  {t.evidence.map((e) => (
                    <a href={`/section/${e.row}-${e.col}`} class="specimen-tag" title={e.cell.html.replace(/<[^>]+>/g, "")}>
                      {gridRef(e.row, e.col)}
                    </a>
                  ))}
                </p>
              )}
              <p class="feed-meta"><strong>{t.author}</strong></p>
            </li>
          ))}
        </ul>
      </section>
      <section class="dig-log trivia-card" id="trivia-card" aria-labelledby="trivia-heading">
        <h2 id="trivia-heading">Daily trivia</h2>
        {
          trivia.answeredToday ? (
            <p class="trivia-done">
              {trivia.correct ? "✅ Correct today." : "You missed today's one."} Current streak: <strong>{trivia.streak}</strong> day{trivia.streak === 1 ? "" : "s"}. Come back tomorrow.
            </p>
          ) : (
            <form method="post" action="/api/trivia" class="trivia-form">
              <p>{question.q}</p>
              <div class="trivia-choices">
                {question.choices.map((choice, i) => (
                  <label class="trivia-choice">
                    <input type="radio" name="choice" value={i} required />
                    <span>{choice}</span>
                  </label>
                ))}
              </div>
              <button type="submit">Answer</button>
            </form>
          )
        }
      </section>
      <section class="dig-log" aria-labelledby="dig-log-heading">
        <h2 id="dig-log-heading">Dig log</h2>
        <ol id="dig-log-list">
          {activity.length === 0 && <li class="dig-log-empty">Nobody has broken ground yet.</li>}
          {activity.map((a) => (
            <li data-key={`${a.at}-${a.ref}-${a.verb}`}>
              <strong>{a.who}</strong> {a.verb} <span class="dig-log-ref">{a.ref}</span>
            </li>
          ))}
        </ol>
      </section>
      {
        past.length > 0 && (
          <section class="dig-log past-digs" aria-labelledby="past-digs-heading">
            <h2 id="past-digs-heading">Past digs</h2>
            <ol id="past-digs-list">
              {past.map((p) => (
                <li>
                  <strong>{p.title}</strong> ({p.year}){p.solvedBy ? <>, named by {p.solvedBy}</> : ", unsolved"}
                </li>
              ))}
            </ol>
            <a href="/history" class="panel-link">See the full history →</a>
          </section>
        )
      }
    </aside>
  </div>

  <script>
    import { untilLabel } from "../lib/countdown";

    // Dragging a revealed cell into the tray only exists on this visitor's
    // own screen, so it's wired fresh after every resync below.
    function wireDragHandles(): void {
      document.querySelectorAll<HTMLElement>(".cell[draggable]").forEach((el) => {
        el.addEventListener("dragstart", (e) => {
          e.dataTransfer?.setData("text/plain", el.dataset.cell ?? "");
        });
      });
    }
    wireDragHandles();

    // Shared regions every open tab keeps in step with, plus this visitor's
    // own tray. The tray is still private: it's only ever refreshed from a
    // fetch carrying this visitor's cookie, never pushed to anyone else.
    const LIVE_IDS = [
      "dig-grid",
      "notes-list",
      "theories-list",
      "dig-log-list",
      "mystery-latest",
      "tray-contents",
      "tray-count",
      "evidence-pick",
      "mystery-evidence",
      "buy-dig-slot",
      "trivia-card",
    ];

    // What each region looked like before a resync, so whatever just changed
    // can be picked out and animated in.
    function snapshot(): { states: Map<string, string>; ids: Set<string> } {
      const states = new Map<string, string>();
      document.querySelectorAll<HTMLElement>("#dig-grid [data-cell]").forEach((el) => {
        states.set(el.dataset.cell ?? "", el.dataset.state ?? "");
      });
      const ids = new Set<string>();
      document
        .querySelectorAll<HTMLElement>("#notes-list [data-id], #theories-list [data-id], #dig-log-list [data-key], #tray-list [data-key]")
        .forEach((el) => ids.add(itemKey(el)));
      return { states, ids };
    }

    // Notes and theories number their ids separately, so an item is keyed by
    // its list too; otherwise theory 3 would pass for the old note 3.
    function itemKey(el: HTMLElement): string {
      return `${el.closest("ul, ol")?.id ?? ""}:${el.dataset.id ?? el.dataset.key ?? ""}`;
    }

    // A field note or theory from someone else pops up as a card and counts
    // on its tab until that tab is opened, so it's seen even while the
    // player has the tray open. Their own posts never notify them.
    const noticesEl = document.getElementById("notices");
    const unread = { notes: 0, theories: 0 };
    const KIND = {
      notes: { icon: "📓", verb: "left a field note", tab: "tab-notes" },
      theories: { icon: "💡", verb: "has a theory", tab: "tab-theories" },
    } as const;

    function renderBadges(): void {
      for (const key of ["notes", "theories"] as const) {
        const badge = document.querySelector<HTMLElement>(`[data-badge="${key}"]`);
        const open = (document.getElementById(KIND[key].tab) as HTMLInputElement | null)?.checked;
        if (open) unread[key] = 0;
        if (!badge) continue;
        badge.textContent = String(unread[key]);
        badge.hidden = unread[key] === 0;
      }
    }

    function notify(key: "notes" | "theories", item: HTMLElement): void {
      if (!noticesEl) return;
      const { icon, verb, tab } = KIND[key];
      const body = item.querySelector("p")?.textContent?.trim() ?? "";
      const card = document.createElement("button");
      card.type = "button";
      card.className = `notice notice-${key}`;
      const head = document.createElement("span");
      head.className = "notice-head";
      head.textContent = `${icon} ${item.dataset.author ?? "Someone"} ${verb}`;
      const text = document.createElement("span");
      text.className = "notice-body";
      text.textContent = body.length > 110 ? body.slice(0, 107) + "…" : body;
      card.append(head, text);
      const dismiss = (): void => {
        card.classList.add("notice-out");
        setTimeout(() => card.remove(), 220);
      };
      card.addEventListener("click", () => {
        const radio = document.getElementById(tab) as HTMLInputElement | null;
        if (radio) radio.checked = true;
        renderBadges();
        document.querySelector(`#${key}-list [data-id="${item.dataset.id}"]`)?.scrollIntoView({ block: "nearest", behavior: "smooth" });
        dismiss();
      });
      noticesEl.prepend(card);
      // keep the stack short
      [...noticesEl.children].slice(3).forEach((el) => el.remove());
      setTimeout(dismiss, 7000);
      unread[key] += 1;
      renderBadges();
    }

    document.querySelectorAll('input[name="field-tab"]').forEach((r) => r.addEventListener("change", renderBadges));

    // The site was named (or brushed clean) and a new one buried: tell
    // everyone, whoever did it.
    function announceNewSite(): void {
      const last = document.querySelector<HTMLElement>("[data-last-solved]")?.dataset.lastSolved;
      if (!noticesEl || !last) return;
      const card = document.createElement("div");
      card.className = "notice notice-solved";
      card.setAttribute("role", "status");
      const head = document.createElement("span");
      head.className = "notice-head";
      head.textContent = `🎉 ${last}`;
      const text = document.createElement("span");
      text.className = "notice-body";
      text.textContent = "A new website has been buried. Start digging!";
      card.append(head, text);
      noticesEl.prepend(card);
      setTimeout(() => card.remove(), 9000);
    }

    function markArrivals(before: ReturnType<typeof snapshot>): void {
      document.querySelectorAll<HTMLElement>("#dig-grid [data-cell]").forEach((el) => {
        const was = before.states.get(el.dataset.cell ?? "");
        if (was && was !== el.dataset.state) el.classList.add("live-arrived");
      });
      document
        .querySelectorAll<HTMLElement>("#notes-list [data-id], #theories-list [data-id], #dig-log-list [data-key], #tray-list [data-key]")
        .forEach((el) => {
          if (before.ids.has(itemKey(el))) return;
          el.classList.add("live-new");
          if (el.hasAttribute("data-mine")) return;
          if (el.classList.contains("note-item")) notify("notes", el);
          else if (el.classList.contains("theory-item")) notify("theories", el);
        });
    }

    // Swaps the live regions for fresh ones in place, so the page never
    // reloads and the scroll position never moves.
    async function resync(html?: string): Promise<void> {
      if (html === undefined) {
        // a failed fetch (offline) leaves the board as it was; the stream
        // reopening resyncs again once there's a connection
        const res = await fetch(location.pathname, { cache: "no-store", headers: { "x-dig-resync": "1" } }).catch(() => null);
        if (!res?.ok) return;
        html = await res.text();
      }
      const fresh = new DOMParser().parseFromString(html, "text/html");
      // a new site means a new page (heading, past digs, empty feeds), so
      // swap the whole thing rather than piece by piece
      const site = (doc: Document): string | undefined => doc.querySelector<HTMLElement>("[data-site]")?.dataset.site;
      if (site(fresh) !== site(document)) {
        // the whole field pane and header change; the notices stack and
        // this script stay, and submits and drops are delegated or rebound.
        // The dig field itself is kept and only its contents swapped, since
        // the pan and tap handling is bound to it, and the live headcount
        // carries over rather than resetting to whatever the fetch rendered.
        const here = document.getElementById("here-count")?.cloneNode(true);
        const keptViewport = document.getElementById("dig-viewport");
        const freshViewport = fresh.getElementById("dig-viewport");
        const freshStage = freshViewport?.querySelector(".iso-stage");
        const keptStage = keptViewport?.querySelector(".iso-stage");
        if (keptViewport && freshViewport && freshStage && keptStage) {
          keptStage.replaceWith(freshStage);
          freshViewport.replaceWith(keptViewport);
        }
        for (const sel of [".expedition-bar", ".excavation-layout"]) {
          const next = fresh.querySelector(sel);
          if (next) document.querySelector(sel)?.replaceWith(next);
        }
        if (here) document.getElementById("here-count")?.replaceWith(here);
        renderHere();
        document.querySelectorAll('input[name="field-tab"]').forEach((r) => r.addEventListener("change", renderBadges));
        unread.notes = unread.theories = 0;
        wireDragHandles();
        wireDrop();
        announceNewSite();
        centreField();
        renderHowTo();
        return;
      }
      const before = snapshot();

      for (const id of LIVE_IDS) {
        const next = fresh.getElementById(id);
        const current = document.getElementById(id);
        if (next && current) current.replaceWith(next);
      }
      for (const attr of ["data-digs-left", "data-recovered", "data-shards"]) {
        const next = fresh.querySelector(`[${attr}]`);
        const current = document.querySelector(`[${attr}]`);
        if (next && current) current.replaceWith(next);
      }
      markArrivals(before);
      wireDragHandles();
    }

    const flashEl = document.getElementById("flash");
    const messages: Record<string, string> = JSON.parse(
      document.getElementById("flash-messages")?.textContent ?? "{}",
    );
    let flashTimer: ReturnType<typeof setTimeout> | undefined;
    const hideFlashSoon = (): void => {
      clearTimeout(flashTimer);
      flashTimer = setTimeout(() => flashEl && (flashEl.hidden = true), 3500);
    };
    if (flashEl && !flashEl.hidden) hideFlashSoon();

    function showFlash(result: string | null): void {
      const text = result ? messages[result] : undefined;
      if (!flashEl || !text) return;
      flashEl.textContent = text;
      flashEl.hidden = false;
      // restart the entrance animation for a repeated message
      flashEl.style.animation = "none";
      void flashEl.offsetWidth;
      flashEl.style.animation = "";
      hideFlashSoon();
    }

    // Posts an action the way its form would, then updates the page where it
    // stands instead of following the redirect into a full reload.
    // The three-step how-to above the board. Each step ticks off the first
    // time the player's own action succeeds (the server's reply, not a guess),
    // and once all three are done the strip folds down to a quiet line. Kept
    // per browser so a returning player isn't taught again; a blocked
    // localStorage just means it keeps showing.
    const HOW_TO_KEY = "dig-how-to";
    const STEP_FOR: Record<string, string> = { ok: "dig", brushed: "brush", archived: "save" };
    function learned(): Set<string> {
      try {
        return new Set(JSON.parse(localStorage.getItem(HOW_TO_KEY) ?? "[]") as string[]);
      } catch {
        return new Set();
      }
    }
    function renderHowTo(): void {
      const strip = document.getElementById("how-to");
      if (!strip) return;
      const done = learned();
      strip.querySelectorAll<HTMLElement>("[data-step]").forEach((li) => li.toggleAttribute("data-done", done.has(li.dataset.step ?? "")));
      strip.toggleAttribute("data-learned", ["dig", "brush", "save"].every((s) => done.has(s)));
    }
    function learn(result: string | null): void {
      const step = result ? STEP_FOR[result] : undefined;
      if (!step) return;
      const done = learned();
      if (done.has(step)) return;
      done.add(step);
      try {
        localStorage.setItem(HOW_TO_KEY, JSON.stringify([...done]));
      } catch {}
      renderHowTo();
    }
    renderHowTo();

    async function act(action: string, body: URLSearchParams, near?: Element): Promise<void> {
      let res: Response;
      try {
        res = await fetch(action, {
          method: "POST",
          headers: { "content-type": "application/x-www-form-urlencoded" },
          body,
        });
      } catch {
        // No connection at all: nothing reached the server, so say that
        // rather than leaving the tap to look ignored.
        showFlash("no-connection");
        return;
      }
      const landed = new URL(res.url);
      const result = landed.searchParams.get("r");
      await resync(res.ok && landed.pathname === location.pathname ? await res.text() : undefined);
      learn(result);
      // Out of digs is answered where the player tapped, not as a toast in
      // the corner; the tile was re-rendered by the resync, so find it again.
      if (result === "out-of-digs") {
        const cell = body.get("cell");
        showOutOfDigs((cell && document.getElementById(`cell-${cell}`)) || near);
        return;
      }
      showFlash(result);
    }

    const IN_PLACE = new Set(["/api/dig", "/api/brush", "/api/archive", "/api/notes", "/api/theories", "/api/shop", "/api/trivia"]);

    // Out of digs, told where the player tapped rather than in the status
    // strip they may have scrolled past. The server still enforces both the
    // cap and the price; this only reads the numbers it last rendered.
    const oodEl = document.getElementById("out-of-digs");
    function digsLeft(): number {
      return Number(document.querySelector<HTMLElement>("[data-digs-left]")?.dataset.digsLeft ?? 0);
    }

    // Time until free digs return. The instant comes from the server, which
    // owns the day boundary; this only counts down to it, as the page renders
    // it ("4h 18m"), and once it passes the next resync brings fresh digs.
    function resetIn(): string {
      const at = Date.parse(document.querySelector<HTMLElement>("[data-reset-at]")?.dataset.resetAt ?? "");
      return Number.isNaN(at) ? "under a day" : untilLabel(at);
    }
    function tickReset(): void {
      const el = document.querySelector<HTMLElement>("[data-reset-in]");
      if (el) el.textContent = resetIn();
      const sheet = document.getElementById("ood-reset");
      if (sheet && oodEl && !oodEl.hidden) sheet.textContent = resetIn();
      const at = Date.parse(document.querySelector<HTMLElement>("[data-reset-at]")?.dataset.resetAt ?? "");
      // past the reset: fetch the page again so the fresh digs show up
      if (!Number.isNaN(at) && Date.now() >= at + 2000 && digsLeft() === 0) void resync();
    }
    setInterval(tickReset, 30_000);
    function showOutOfDigs(near?: Element): void {
      if (!oodEl) return;
      const shards = Number(document.querySelector<HTMLElement>("[data-shards]")?.dataset.shards ?? 0);
      const cost = Number(document.getElementById("buy-dig-slot")?.dataset.cost ?? 10);
      const affordable = shards >= cost;
      const shardsEl = document.getElementById("ood-shards");
      const detail = document.getElementById("ood-detail");
      const buy = document.getElementById("ood-buy");
      const buyButton = document.getElementById("ood-buy-button");
      if (shardsEl) shardsEl.textContent = String(shards);
      const resetEl = document.getElementById("ood-reset");
      if (resetEl) resetEl.textContent = resetIn();
      if (detail) {
        detail.textContent = affordable
          ? `A bonus dig costs ${cost} 💎.`
          : `A bonus dig costs ${cost} 💎, so you need ${cost - shards} more. Solve a site or answer the daily trivia to earn some.`;
      }
      if (buy) buy.hidden = !affordable;
      if (buyButton) buyButton.textContent = `Buy a dig for ${cost} 💎`;
      // one message at a time: a toast left over from the last dig would
      // otherwise sit on top of this
      const toast = document.getElementById("flash");
      if (toast) toast.hidden = true;
      oodEl.hidden = false;
      // Sits just under the tapped tile if there's room below it, else above.
      const rect = near?.getBoundingClientRect();
      const box = oodEl.getBoundingClientRect();
      const margin = 12;
      let top = rect ? rect.bottom + margin : (window.innerHeight - box.height) / 2;
      if (rect && top + box.height > window.innerHeight - margin) top = rect.top - box.height - margin;
      oodEl.style.top = `${Math.max(margin, Math.min(top, window.innerHeight - box.height - margin))}px`;
      (affordable ? buyButton : document.getElementById("ood-close"))?.focus({ preventScroll: true });
    }
    function hideOutOfDigs(): void {
      if (oodEl) oodEl.hidden = true;
    }
    document.getElementById("ood-close")?.addEventListener("click", hideOutOfDigs);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") hideOutOfDigs();
    });
    document.addEventListener("pointerdown", (e) => {
      if (oodEl && !oodEl.hidden && !oodEl.contains(e.target as Node)) hideOutOfDigs();
    });

    // Touch has no hover and no drag-and-drop to the tray, so on a coarse
    // pointer the revealed find itself is the add-to-tray control, and the
    // small + is hidden. A find already in the tray opens its detail page.
    const coarse = window.matchMedia("(pointer: coarse)");

    // On a slow link a dig takes a couple of seconds to come back, and with
    // nothing changing on screen a second tap looks like the obvious fix. The
    // server already refuses the duplicate, but the player then reads "Someone
    // got to that section first" about their own dig. So a tile shows it's
    // working the moment it's tapped, and takes no more taps until its reply
    // lands. Keyed by cell, so a different tile can still be tapped meanwhile.
    const inFlight = new Set<string>();
    function markPending(cell: string, on: boolean): void {
      document.getElementById(`cell-${cell}`)?.toggleAttribute("data-pending", on);
    }
    async function actOnce(cell: string, action: string, body: URLSearchParams, near?: Element): Promise<void> {
      if (inFlight.has(cell)) return;
      inFlight.add(cell);
      markPending(cell, true);
      try {
        await act(action, body, near);
      } finally {
        inFlight.delete(cell);
        // the resync usually swapped the tile for a fresh one already
        markPending(cell, false);
      }
    }

    document.addEventListener("submit", (e) => {
      const form = e.target as HTMLFormElement;
      const submitter = e.submitter as HTMLButtonElement | null;
      const action = submitter?.getAttribute("formaction") ?? form.getAttribute("action") ?? "";
      if (!IN_PLACE.has(action)) return;
      e.preventDefault();
      hideOutOfDigs();
      if (action === "/api/dig" && submitter?.dataset.state === "buried" && digsLeft() === 0) {
        showOutOfDigs(submitter);
        return;
      }
      // entries, not an object, so repeated fields (several evidence picks)
      // all survive
      const body = new URLSearchParams([...new FormData(form, submitter)].map(([k, v]) => [k, String(v)]));
      if (form.querySelector("[name=body]")) form.reset();
      const cell = body.get("cell");
      if (cell && (action === "/api/dig" || action === "/api/brush" || action === "/api/archive")) {
        void actOnce(cell, action, body, submitter ?? undefined);
        return;
      }
      void act(action, body, submitter ?? undefined);
    });

    // The dig site on a phone: a bounded map the player drags around, never
    // a page that scrolls sideways. The browser does the panning itself
    // (touch-action on the field), so it stays smooth; this only decides
    // which finger-ups count as taps.
    const field = document.getElementById("iso-field");
    const TAP_SLOP = 10;
    let down: { x: number; y: number; id: number } | null = null;
    let dragged = false;

    field?.addEventListener(
      "pointerdown",
      (e) => {
        down = { x: e.clientX, y: e.clientY, id: e.pointerId };
        dragged = false;
      },
      { passive: true },
    );
    field?.addEventListener(
      "pointermove",
      (e) => {
        if (!down || e.pointerId !== down.id || dragged) return;
        if (Math.hypot(e.clientX - down.x, e.clientY - down.y) > TAP_SLOP) dragged = true;
      },
      { passive: true },
    );
    // A pan the browser takes over fires pointercancel, never a click, but
    // a slow drag can still end in one: either way it's not a tap.
    field?.addEventListener("pointercancel", () => {
      dragged = true;
    });
    // Only a scroll the player started counts as having explored the map;
    // the scroll centreField() makes on load mustn't dismiss the hint.
    field?.addEventListener("scroll", () => {
      if (!down) return;
      dragged = true;
      hidePanHint();
    }, { passive: true });

    // Capture phase, on the field rather than the grid: the grid is replaced
    // on every resync, the field isn't, and this has to run before the
    // tile's own button or link acts on the click.
    field?.addEventListener(
      "click",
      (e) => {
        const wasDrag = dragged;
        down = null;
        dragged = false;
        // any deliberate touch on the map means they've found it
        hidePanHint();
        if (wasDrag) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        if (!coarse.matches) return;
        const link = (e.target as Element).closest<HTMLAnchorElement>("a.cell[data-state='revealed']");
        const find = link?.closest<HTMLElement>(".find");
        if (!link || !find || find.hasAttribute("data-saved")) return;
        e.preventDefault();
        e.stopPropagation();
        find.setAttribute("data-saved", "");
        const cell = link.dataset.cell ?? "";
        void actOnce(cell, "/api/archive", new URLSearchParams({ cell, action: "add" }), link);
      },
      true,
    );

    // First look at the map on a phone: start on the plot rather than the
    // empty corner of grass, and say once that it moves.
    const panHint = document.getElementById("pan-hint");
    const HINT_KEY = "dig-pan-hint-seen";
    function hidePanHint(): void {
      if (!panHint || panHint.hidden) return;
      panHint.hidden = true;
      try {
        localStorage.setItem(HINT_KEY, "1");
      } catch {}
    }
    const viewport = document.getElementById("dig-viewport");
    // Only a field that actually scrolls is a map: on desktop it's
    // overflow: hidden and the drawing's overhang must not count.
    const overflows = (): boolean => {
      if (!field) return false;
      const cs = getComputedStyle(field);
      const scrolls = (v: string): boolean => v === "auto" || v === "scroll";
      return (
        (scrolls(cs.overflowX) && field.scrollWidth > field.clientWidth + 1) ||
        (scrolls(cs.overflowY) && field.scrollHeight > field.clientHeight + 1)
      );
    };
    function updateEdges(): void {
      if (!field || !viewport) return;
      const maxX = field.scrollWidth - field.clientWidth;
      const maxY = field.scrollHeight - field.clientHeight;
      viewport.classList.toggle("pannable", overflows());
      viewport.classList.toggle("more-left", field.scrollLeft > 4);
      viewport.classList.toggle("more-right", field.scrollLeft < maxX - 4);
      viewport.classList.toggle("more-up", field.scrollTop > 4);
      viewport.classList.toggle("more-down", field.scrollTop < maxY - 4);
    }
    function centreField(): void {
      if (!field) return;
      updateEdges();
      if (!overflows()) return;
      const grid = document.getElementById("dig-grid");
      const g = grid?.getBoundingClientRect();
      const f = field.getBoundingClientRect();
      if (g) {
        // Aim at the middle of the plot itself, which sits right of centre
        // in the drawing, not the middle of the whole stage.
        field.scrollLeft += g.left + g.width / 2 - (f.left + f.width / 2);
        field.scrollTop += g.top + g.height / 2 - (f.top + f.height / 2);
      }
      updateEdges();
      let seen = false;
      try {
        seen = localStorage.getItem(HINT_KEY) === "1";
      } catch {}
      if (panHint && !seen) panHint.hidden = false;
    }
    field?.addEventListener("scroll", updateEdges, { passive: true });
    centreField();
    window.addEventListener("resize", updateEdges);

    // Cap the evidence picks: once the limit is reached, the rest disable.
    document.addEventListener("change", (e) => {
      const set = (e.target as HTMLElement).closest<HTMLFieldSetElement>(".evidence-pick");
      if (!set) return;
      const max = Number(set.dataset.max ?? 3);
      const boxes = [...set.querySelectorAll<HTMLInputElement>("input[type=checkbox]")];
      const full = boxes.filter((b) => b.checked).length >= max;
      boxes.forEach((b) => (b.disabled = full && !b.checked));
    });

    // The tray is replaced whole when a new site is buried, so its drop
    // target is wired as a function too.
    function wireDrop(): void {
      const drop = document.querySelector<HTMLElement>("[data-tray-drop]");
      if (!drop) return;
      drop.addEventListener("dragover", (e) => {
        e.preventDefault();
        drop.classList.add("drag-over");
      });
      drop.addEventListener("dragleave", () => drop.classList.remove("drag-over"));
      drop.addEventListener("drop", (e) => {
        e.preventDefault();
        drop.classList.remove("drag-over");
        const cell = e.dataTransfer?.getData("text/plain");
        if (cell) void act("/api/archive", new URLSearchParams({ cell, action: "add" }));
      });
    }
    wireDrop();

    let debounce: ReturnType<typeof setTimeout> | undefined;
    const scheduleResync = (): void => {
      clearTimeout(debounce);
      debounce = setTimeout(() => void resync(), 150);
    };

    // Live layer: a dig, brush, note or theory anywhere reaches every open
    // tab within about a second. A reconnect after a dropped connection
    // resyncs too, to catch the visitor up on what they missed; the first
    // connect doesn't, since the page has only just rendered.
    //
    // A dropped stream used to be invisible: the board just stopped moving
    // and still looked live. Now the headcount and a small banner say so.
    // EventSource retries on its own (the server asks for every 2s), and
    // while the browser reports no network at all there's nothing to retry
    // over, so that reads "offline" rather than "reconnecting". Its state
    // is derived again on each change rather than tracked as flags, since
    // "online" and "open" can arrive in either order.
    // The return summary is read once and put away; it's built fresh on the
    // next return, so there's nothing to remember about dismissing it.
    document.getElementById("since-away-close")?.addEventListener("click", () => {
      const panel = document.getElementById("since-away");
      if (panel) panel.hidden = true;
      // a full-height desktop layout has room for the board again
      centreField();
    });

    const liveBanner = document.getElementById("live-banner");
    let lastCount = Number(document.getElementById("here-count")?.dataset.here ?? 0);
    let liveState: "live" | "reconnecting" | "offline" = "live";
    let liveTimer: ReturnType<typeof setTimeout> | undefined;

    function renderHere(): void {
      // looked up each time: a new site swaps the header the count lives in
      const hereEl = document.getElementById("here-count");
      if (!hereEl) return;
      hereEl.dataset.live = liveState;
      hereEl.dataset.here = String(lastCount);
      const strong = hereEl.querySelector("strong");
      const word = hereEl.querySelector("#here-word");
      const tail = hereEl.querySelector<HTMLElement>("#here-tail");
      // Off the live stream the count is stale, so it isn't shown as a fact.
      if (strong) strong.textContent = liveState === "live" ? String(lastCount) : "";
      if (tail) tail.hidden = liveState !== "live";
      if (word) {
        word.textContent =
          liveState === "offline"
            ? "Offline, showing the board as you last saw it"
            : liveState === "reconnecting"
              ? "Reconnecting to the dig…"
              : lastCount === 1
                ? "person"
                : "people";
      }
    }

    function setLive(next: typeof liveState): void {
      if (next === liveState) return;
      const was = liveState;
      liveState = next;
      renderHere();
      if (!liveBanner) return;
      clearTimeout(liveTimer);
      if (next === "live") {
        // only worth saying if it was ever said to be down
        if (liveBanner.hidden) return;
        liveBanner.dataset.live = "live";
        liveBanner.textContent = "Back online. The dig is up to date.";
        liveTimer = setTimeout(() => (liveBanner.hidden = true), 2500);
        return;
      }
      liveBanner.dataset.live = next;
      // the header wraps to two rows on a phone, so measure where it ends
      const header = document.querySelector(".site-header")?.getBoundingClientRect();
      if (header) liveBanner.style.setProperty("--header-h", `${Math.max(0, header.bottom)}px`);
      liveBanner.textContent =
        next === "offline"
          ? "You're offline. Digs and notes will need a connection."
          : "Lost the live connection. Reconnecting…";
      // A blip shorter than this (a phone waking, a proxy recycling the
      // stream) isn't worth flashing a banner over; the headcount already
      // shows it. Going offline is said straight away.
      if (next === "offline" || was === "offline") liveBanner.hidden = false;
      else liveTimer = setTimeout(() => (liveBanner.hidden = false), 1500);
    }

    let events: EventSource;
    let connectedBefore = false;
    let retry: ReturnType<typeof setTimeout> | undefined;

    // The browser retries a dropped stream by itself, but gives up for good
    // on an error response (a 502 from the proxy mid-deploy, say), so a
    // closed stream is reopened here, a little later each time.
    let backoff = 2000;
    function connect(): void {
      clearTimeout(retry);
      events = new EventSource("/api/events");
      events.addEventListener("message", scheduleResync);
      events.addEventListener("open", () => {
        if (connectedBefore) scheduleResync();
        connectedBefore = true;
        backoff = 2000;
        setLive("live");
      });
      events.addEventListener("error", () => {
        setLive(navigator.onLine ? "reconnecting" : "offline");
        if (events.readyState !== EventSource.CLOSED) return;
        retry = setTimeout(connect, backoff);
        backoff = Math.min(backoff * 2, 30_000);
      });
      // The live headcount: pushed as its own event because the count itself
      // is the payload, unlike "changed" which is just a cue to re-fetch.
      events.addEventListener("here", (e) => {
        const count = Number((e as MessageEvent).data);
        if (Number.isNaN(count)) return;
        lastCount = count;
        setLive("live");
        renderHere();
      });
    }
    connect();

    window.addEventListener("offline", () => setLive("offline"));
    window.addEventListener("online", () => {
      if (events.readyState === EventSource.OPEN) return setLive("live");
      setLive("reconnecting");
      // don't wait out the backoff once the network is back
      if (events.readyState === EventSource.CLOSED) {
        backoff = 2000;
        connect();
      }
    });
  </script>
</Layout>
