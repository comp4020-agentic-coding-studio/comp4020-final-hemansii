---
// An original explorer badge, drawn in the manner of ligne claire (flat
// colour, one uniform black outline weight) — not a likeness of any
// existing character, just the technique the reference art uses.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true">
  <circle cx="16" cy="16" r="14.5" fill="#e3ac3d" stroke="#15120d" stroke-width="1.6" />
  <path d="M4 15 Q16 5 28 15 L28 17.5 Q16 10 4 17.5 Z" fill="#b4863f" stroke="#15120d" stroke-width="1.4" stroke-linejoin="round" />
  <path d="M9.5 14.5 Q16 8.5 22.5 14.5 L21.3 15.3 Q16 11 10.7 15.3 Z" fill="#8a6225" stroke="#15120d" stroke-width="1.2" stroke-linejoin="round" />
  <ellipse cx="16" cy="21" rx="7.4" ry="7.6" fill="#f0c48f" stroke="#15120d" stroke-width="1.5" />
  <circle cx="12.6" cy="20.2" r="1.15" fill="#15120d" />
  <circle cx="19.4" cy="20.2" r="1.15" fill="#15120d" />
  <path d="M12.6 23.6 Q16 26 19.4 23.6" stroke="#15120d" stroke-width="1.3" fill="none" stroke-linecap="round" />
</svg>
