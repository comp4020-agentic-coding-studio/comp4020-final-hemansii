---
// A small set of scattered expedition props, ligne claire flat shapes in
// the manner of Mascot/Companion, used sparingly as margin decoration
// around the hero and grid frame. Purely decorative.
interface Props {
  name: "trowel" | "compass" | "crate" | "helmet" | "flag" | "shovel" | "hand-brush" | "clipboard";
  class?: string;
}
const { name, class: className } = Astro.props;
---

{
  name === "trowel" && (
    <svg class={className} viewBox="0 0 40 40" aria-hidden="true">
      <g transform="rotate(-28 20 20)">
        <rect x="18" y="4" width="4" height="16" rx="1.4" fill="#e3ac3d" stroke="#15120d" stroke-width="1.8" />
        <path d="M11 20 L29 20 L24 34 L16 34 Z" fill="#cfd3d6" stroke="#15120d" stroke-width="1.8" stroke-linejoin="round" />
      </g>
    </svg>
  )
}
{
  name === "compass" && (
    <svg class={className} viewBox="0 0 40 40" aria-hidden="true">
      <circle cx="20" cy="20" r="15" fill="#faf3e2" stroke="#15120d" stroke-width="2" />
      <circle cx="20" cy="20" r="10.5" fill="none" stroke="#8a6225" stroke-width="1.2" />
      <path d="M20 10 L23.5 20 L20 30 L16.5 20 Z" fill="#c23b28" stroke="#15120d" stroke-width="1.4" stroke-linejoin="round" />
      <circle cx="20" cy="20" r="2" fill="#15120d" />
    </svg>
  )
}
{
  name === "crate" && (
    <svg class={className} viewBox="0 0 40 40" aria-hidden="true">
      <rect x="6" y="14" width="28" height="20" fill="#b4863f" stroke="#15120d" stroke-width="2" stroke-linejoin="round" />
      <path d="M6 14 L20 7 L34 14" fill="none" stroke="#15120d" stroke-width="2" stroke-linejoin="round" />
      <path d="M6 14 L20 21 L34 14" fill="#8a6225" stroke="#15120d" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M20 21 L20 34" stroke="#15120d" stroke-width="1.6" />
    </svg>
  )
}
{
  name === "helmet" && (
    <svg class={className} viewBox="0 0 40 40" aria-hidden="true">
      <path d="M7 26 Q7 12 20 11 Q33 12 33 26 Z" fill="#e3ac3d" stroke="#15120d" stroke-width="2" stroke-linejoin="round" />
      <rect x="4" y="25" width="32" height="5" rx="2.5" fill="#b9842a" stroke="#15120d" stroke-width="1.8" />
      <rect x="16" y="6" width="8" height="6" rx="1.5" fill="#b9842a" stroke="#15120d" stroke-width="1.6" />
    </svg>
  )
}
{
  name === "flag" && (
    <svg class={className} viewBox="0 0 40 40" aria-hidden="true">
      <path d="M12 36 L12 6" stroke="#15120d" stroke-width="2" stroke-linecap="round" />
      <path d="M12 7 L30 11 L12 17 Z" fill="#c23b28" stroke="#15120d" stroke-width="1.8" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === "shovel" && (
    <svg class={className} viewBox="0 0 40 40" aria-hidden="true">
      <g transform="rotate(18 20 20)">
        <rect x="18.5" y="4" width="3" height="20" rx="1.2" fill="#8a7a3f" stroke="#15120d" stroke-width="1.6" />
        <path d="M12 23 Q20 19 28 23 L26 34 Q20 38 14 34 Z" fill="#8fa3ad" stroke="#15120d" stroke-width="1.8" stroke-linejoin="round" />
      </g>
    </svg>
  )
}
{
  name === "hand-brush" && (
    <svg class={className} viewBox="0 0 40 40" aria-hidden="true">
      <g transform="rotate(-20 20 20)">
        <rect x="10" y="10" width="20" height="7" rx="2" fill="#b9842a" stroke="#15120d" stroke-width="1.6" />
        <path d="M10 17 L30 17 L28 28 L12 28 Z" fill="#e3ac3d" stroke="#15120d" stroke-width="1.6" stroke-linejoin="round" />
        <path d="M13 28 L13 32 M17 28 L17 33 M20 28 L20 33 M23 28 L23 33 M27 28 L27 32" stroke="#6c6030" stroke-width="1.3" stroke-linecap="round" />
      </g>
    </svg>
  )
}
{
  name === "clipboard" && (
    <svg class={className} viewBox="0 0 40 40" aria-hidden="true">
      <rect x="8" y="6" width="24" height="30" rx="2.5" fill="#faf3e2" stroke="#15120d" stroke-width="2" />
      <rect x="15" y="3" width="10" height="6" rx="2" fill="#8a7a3f" stroke="#15120d" stroke-width="1.6" />
      <path d="M12 15 H28 M12 20 H28 M12 25 H22" stroke="#3a3028" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  )
}
