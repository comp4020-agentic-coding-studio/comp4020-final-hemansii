---
// The excavation's surroundings, drawn around the interactive grid from the
// terrain asset sheets (public/terrain): the field of grass and its scatter,
// the turf block the plot sits on with its soil faces, the trench cut along
// its two far sides, the rope and survey posts, and the expedition's kit set
// out on the grass. Purely decorative; tiles are HTML.
//
// Coordinates are in hundredths of a tile side (s = 100), matching .iso-stage
// in styles.css: a 6 x 10 grid turned 45deg and squashed to K of its height.
// at(lx, ly) maps a point on that plane to the stage.
interface Props {
  layer: "under" | "over";
  class?: string;
}
const { layer, class: className } = Astro.props;

type P = [number, number];
const K = 0.58;
const MX = 46;
const MTOP = 60;
const MBOTTOM = 46;
const S2 = Math.SQRT1_2;
const W = 1131.37 + 2 * MX;
const H = 1131.37 * K + MTOP + MBOTTOM;
const at = (lx: number, ly: number): P => [707.11 + MX + (lx - ly) * S2, MTOP + (lx + ly) * S2 * K];
const T = at(0, 0);
// The same plane as a transform, for drawing flat on the ground in plane units.
const PLANE = `translate(${T[0].toFixed(2)} ${T[1].toFixed(2)}) scale(1 ${K}) rotate(45)`;
// Faces standing upright along either edge direction lean by this much.
const SKEW = (Math.atan(K * 1) * 180) / Math.PI;

const pts = (ps: P[]): string => ps.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
const lerp = (a: P, b: P, t: number): P => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
const xy = ([x, y]: P): string => `${x.toFixed(2)} ${y.toFixed(2)}`;

// Deterministic, so the field looks the same on every render and live resyncs
// never shuffle the grass.
let seed = 11;
const rand = (): number => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};

// The block the plot sits on, like the blocks on the excavation sheet: a
// margin M of turf past the grid on its two near sides, and a trench E wide
// and DB deep cut along its two far sides. Its near faces drop DROP.
const M = 24;
const E = 32;
const DB = 6;
const DROP = 26;
const down = ([x, y]: P, d = DROP): P => [x, y + d];
const NW = at(-E, -E);
const NE = at(600 + M, -E);
const NEi = at(600 + M, 0);
const SE = at(600 + M, 1000 + M);
const SWi = at(0, 1000 + M);
const SW = at(-E, 1000 + M);
const turf: P[] = [at(0, 0), NEi, SE, SWi];
const trench: P[] = [NW, NE, NEi, at(0, 0), SWi, SW];
const faceLeft: P[] = [SWi, SE, down(SE), down(SWi)];
const faceRight: P[] = [SE, NEi, down(NEi), down(SE)];
// where each trench runs out through a near face, the face starts lower
const notchLeft: P[] = [down(SW, DB), down(SWi, DB), down(SWi), down(SW)];
const notchRight: P[] = [down(NEi, DB), down(NE, DB), down(NE), down(NEi)];
const wallNorth: P[] = [NW, NE, down(NE, DB), down(NW, DB)];
const wallWest: P[] = [SW, NW, down(NW, DB), down(SW, DB)];
// The block's own shadow on the grass, falling down and right from the
// bottom of its near faces, longest off the shaded right face.
const shift = ([x, y]: P, dx: number, dy: number): P => [x + dx, y + dy];
const blockShadow: P[] = [down(SW), down(SE), down(NE), shift(down(NE), 16, 4), shift(down(SE), 12, 9), shift(down(SW), 5, 4)];

// Rope round the plot: out on the grass past the trench on the far sides,
// on the block's turf margin on the near sides. A post at each corner and
// midpoint, the rope tied on at the post's red band.
const ROPE = 44;
const rope: P[] = [at(-ROPE, -ROPE), at(612, -ROPE), at(612, 1012), at(-ROPE, 1012)];
const stakes: P[] = rope.flatMap((p, i) => [p, lerp(p, rope[(i + 1) % 4], 0.5)]);
const POST = { w: 11.5, h: 27.5, tie: 11 };
const sag = (a: P, b: P): string => {
  const [mx, my] = lerp(a, b, 0.5);
  return `M${a[0]},${a[1] - POST.tie} Q${mx},${my - POST.tie + 8} ${b[0]},${b[1] - POST.tie}`;
};

function insidePoly([x, y]: P, poly: P[]): boolean {
  let inside = false;
  for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
    const [xi, yi] = poly[i];
    const [xj, yj] = poly[j];
    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside;
  }
  return inside;
}
// Keep the scatter off the block, its faces and the ring of survey labels.
const PAD = 48;
const clear: P[] = [
  at(-E - PAD, -E - PAD),
  at(600 + M + PAD, -E - PAD),
  down(at(600 + M + PAD, -E - PAD), DROP + 10),
  down(at(600 + M + PAD, 1000 + M + PAD), DROP + 10),
  down(at(-E - PAD, 1000 + M + PAD), DROP + 10),
  at(-E - PAD, 1000 + M + PAD),
];

// Props from the expedition asset sheets (public/props), placed in four
// deliberate spots outside the rope, in stage units.
//
// One light for the whole scene, from the top left, so every shadow starts
// directly under its object and falls a little down and to the right. A
// shadow is the prop's own silhouette, darkened, softened and laid flat on
// the ground from its foot line; `lift` is how far the object stands up from
// the grass, as a share of its drawn height, so a standing tripod casts a
// longer shadow than a trowel lying flat. `footY` is where it meets the
// ground, as a fraction of its box height. `baked` skips the shadow for any
// asset that already has one drawn in (none of the current sheets do).
const SHADOW: P = [0.55, 0.3];
type Prop = { src: string; x: number; y: number; w: number; h: number; lift: number; footY: number; baked?: boolean };
const props: Prop[] = [
  // sieve station, far left
  { src: "bucket", x: 128, y: 150, w: 70, h: 94, lift: 0.3, footY: 0.97 },
  { src: "trowel", x: 206, y: 206, w: 64, h: 68, lift: 0.05, footY: 0.92 },
  { src: "brush", x: 280, y: 196, w: 48, h: 46, lift: 0.05, footY: 0.9 },
  // survey point, far right
  { src: "tripod", x: 1048, y: 52, w: 96, h: 138, lift: 0.34, footY: 0.98 },
  { src: "flag", x: 1150, y: 118, w: 54, h: 84, lift: 0.34, footY: 0.99 },
  // spoil heap, near left
  { src: "spoil-heap", x: 36, y: 584, w: 206, h: 176, lift: 0.18, footY: 0.88 },
  // camp, near right
  { src: "specimen-tray", x: 868, y: 632, w: 150, h: 102, lift: 0.05, footY: 0.92 },
  { src: "crate", x: 1036, y: 486, w: 124, h: 110, lift: 0.24, footY: 0.97 },
  { src: "shovel", x: 1158, y: 392, w: 30, h: 108, lift: 0.34, footY: 0.99 },
  { src: "pickaxe", x: 1080, y: 606, w: 118, h: 109, lift: 0.05, footY: 0.9 },
];
const underProp = ([x, y]: P): boolean => props.some((p) => x > p.x - 14 && x < p.x + p.w + 14 && y > p.y + p.h * 0.3 && y < p.y + p.h + 16);

// Scatter from the overlay sheet, at its own size times SCALE, anchored at
// the bottom centre (where a tuft meets the ground).
type Decal = { src: string; x: number; y: number; w: number; h: number };
const VEG: { src: string; w: number; h: number; weight: number }[] = [
  { src: "tuft-s", w: 32, h: 53, weight: 3 },
  { src: "tuft-tall", w: 63, h: 77, weight: 2 },
  { src: "tuft-xs", w: 36, h: 33, weight: 4 },
  { src: "tufts-pair", w: 101, h: 47, weight: 2 },
  { src: "tufts-small", w: 67, h: 40, weight: 3 },
  { src: "bush", w: 105, h: 73, weight: 1 },
  { src: "flowers-a", w: 26, h: 49, weight: 2 },
  { src: "flowers-b", w: 28, h: 52, weight: 2 },
  { src: "flowers-c", w: 86, h: 63, weight: 3 },
  { src: "clover", w: 82, h: 78, weight: 2 },
];
const pick = <T extends { weight: number }>(list: T[]): T => {
  let r = rand() * list.reduce((n, v) => n + v.weight, 0);
  for (const v of list) if ((r -= v.weight) < 0) return v;
  return list[0];
};
const decal = (src: string, w: number, h: number, [x, y]: P, scale: number): Decal => ({ src, x: x - (w * scale) / 2, y: y - h * scale, w: w * scale, h: h * scale });

const scatter: Decal[] = [];
const spots: P[] = [];
for (let tries = 0; spots.length < 44 && tries < 4000; tries++) {
  const p: P = [20 + rand() * (W - 40), 30 + rand() * (H - 36)];
  if (insidePoly(p, clear) || underProp(p)) continue;
  if (spots.some(([x, y]) => Math.hypot(x - p[0], (y - p[1]) * 1.7) < 62)) continue;
  spots.push(p);
  const v = pick(VEG);
  scatter.push(decal(v.src, v.w, v.h, p, 0.42 + rand() * 0.1));
}
const STONES = [
  { src: "stone-cluster", w: 34, h: 17, weight: 1 },
  { src: "stone-a", w: 17, h: 13, weight: 2 },
];
for (let tries = 0, n = 0; n < 9 && tries < 2000; tries++) {
  const p: P = [20 + rand() * (W - 40), 30 + rand() * (H - 36)];
  if (insidePoly(p, clear) || underProp(p)) continue;
  if (spots.some(([x, y]) => Math.hypot(x - p[0], (y - p[1]) * 1.7) < 40)) continue;
  spots.push(p);
  n++;
  const s = pick(STONES);
  scatter.push(decal(s.src, s.w, s.h, p, 1));
}
// Placed by hand: worn ground by the spoil heap and the camp, a sherd
// tossed on the heap's edge, and a lone survey peg out by the tripod.
const placed: Decal[] = [
  decal("dust-b", 95, 72, [266, 706], 0.9),
  decal("dust-a", 96, 80, [990, 640], 0.85),
  decal("sherd", 79, 60, [262, 672], 0.42),
  decal("stake", 56, 69, [992, 140], 0.5),
];
const ground = [...placed.filter((d) => d.src.startsWith("dust")), ...[...scatter, ...placed.filter((d) => !d.src.startsWith("dust"))].sort((a, b) => a.y + a.h - (b.y + b.h))];

// A few small tufts on the plot's own turf; they show through the clear
// turf tiles and are covered as soon as a section is dug.
const plotDecals: Decal[] = Array.from({ length: 12 }, () => {
  const v = pick(VEG.filter((d) => d.h < 70));
  return decal(v.src, v.w, v.h, at(40 + rand() * 540, 40 + rand() * 940), 0.3);
});

// Broad, soft drifts of lighter and darker turf, so the field isn't one even
// green.
const drift = (x: number, y: number) => ({ x, y, rx: 70 + rand() * 120, ry: 30 + rand() * 50, light: rand() < 0.5 });
const patches = Array.from({ length: 16 }, () => drift(rand() * W, rand() * H));
const plotPatches = Array.from({ length: 8 }, () => drift(...at(rand() * 600, rand() * 1000)));

// Lay the silhouette flat from its foot line y = base: a point `up` above
// the foot lands up * lift along SHADOW from the foot.
const cast = (base: number, lift: number): string => {
  const [kx, ky] = SHADOW;
  return `matrix(1 0 ${(-lift * kx).toFixed(4)} ${(-lift * ky).toFixed(4)} ${(lift * kx * base).toFixed(2)} ${(base * (1 + lift * ky)).toFixed(2)})`;
};
const postShadow = ([x, y]: P): string => {
  const [dx, dy] = [SHADOW[0] * POST.h * 0.34, SHADOW[1] * POST.h * 0.34];
  return pts([[x - 4, y], [x + 4, y], [x + 4 + dx, y + dy], [x - 4 + dx, y + dy]]);
};

const INK = "#4a2f1d";
// Soil textures at their sheet proportions: face 203 x 56, wall 203 x 40.
const FACE_W = (203 * DROP) / 56;
const WALL_W = (203 * DB) / 40;
const NOTCH_W = (203 * (DROP - DB)) / 40;
---

{
  layer === "under" ? (
    <svg class={className} viewBox={`0 0 ${W.toFixed(1)} ${H.toFixed(1)}`} aria-hidden="true">
      <defs>
        <pattern id="iso-grass" width="200" height="200" patternUnits="userSpaceOnUse">
          <image href="/terrain/grass.webp" width="200" height="200" />
        </pattern>
        <pattern id="iso-floor" width="96" height="96" patternUnits="userSpaceOnUse">
          <image href="/terrain/floor.webp" width="96" height="96" />
        </pattern>
        {/* upright soil faces, each texture leaned to run along its face */}
        <pattern id="iso-face-l" width={FACE_W} height={DROP} patternUnits="userSpaceOnUse" patternTransform={`translate(${xy(SW)}) skewY(${SKEW})`}>
          <image href="/terrain/face.webp" width={FACE_W} height={DROP} preserveAspectRatio="none" />
        </pattern>
        <pattern id="iso-face-r" width={FACE_W} height={DROP} patternUnits="userSpaceOnUse" patternTransform={`translate(${xy(SE)}) skewY(${-SKEW})`}>
          <image href="/terrain/face.webp" width={FACE_W} height={DROP} preserveAspectRatio="none" />
        </pattern>
        <pattern id="iso-wall-n" width={WALL_W} height={DB} patternUnits="userSpaceOnUse" patternTransform={`translate(${xy(NW)}) skewY(${SKEW})`}>
          <image href="/terrain/wall-h.webp" width={WALL_W} height={DB} preserveAspectRatio="none" />
        </pattern>
        <pattern id="iso-wall-w" width={WALL_W} height={DB} patternUnits="userSpaceOnUse" patternTransform={`translate(${xy(NW)}) skewY(${-SKEW})`}>
          <image href="/terrain/wall-h.webp" width={WALL_W} height={DB} preserveAspectRatio="none" />
        </pattern>
        <pattern id="iso-notch-l" width={NOTCH_W} height={DROP - DB} patternUnits="userSpaceOnUse" patternTransform={`translate(${xy(down(SW, DB))}) skewY(${SKEW})`}>
          <image href="/terrain/wall-h.webp" width={NOTCH_W} height={DROP - DB} preserveAspectRatio="none" />
        </pattern>
        <pattern id="iso-notch-r" width={NOTCH_W} height={DROP - DB} patternUnits="userSpaceOnUse" patternTransform={`translate(${xy(down(NE, DB))}) skewY(${-SKEW})`}>
          <image href="/terrain/wall-h.webp" width={NOTCH_W} height={DROP - DB} preserveAspectRatio="none" />
        </pattern>
        {/* turf lips, drawn flat on the plane: the field's edge hanging over
            the trench, and the plot turf's edge hanging over it from the
            other side */}
        <pattern id="iso-lip-n" x={-E} y={-E - 5} width="122" height="12" patternUnits="userSpaceOnUse">
          <image href="/terrain/lip-h.webp" width="122" height="12" preserveAspectRatio="none" />
        </pattern>
        <pattern id="iso-lip-w" x={-E - 5} y={-E} width="12" height="122" patternUnits="userSpaceOnUse">
          <image href="/terrain/lip-v.webp" width="12" height="122" preserveAspectRatio="none" />
        </pattern>
        <pattern id="iso-lip-s" x="0" y="-6" width="91" height="9" patternUnits="userSpaceOnUse">
          <image href="/terrain/lip-s.webp" width="91" height="9" preserveAspectRatio="none" />
        </pattern>
        <pattern id="iso-lip-e" x="-6" y="0" width="9" height="91" patternUnits="userSpaceOnUse">
          <image href="/terrain/lip-e.webp" width="9" height="91" preserveAspectRatio="none" />
        </pattern>
        <clipPath id="iso-plot">
          <polygon points={pts(turf)} />
        </clipPath>
        <radialGradient id="iso-sun" cx="0.3" cy="0.25" r="0.75">
          <stop offset="0" stop-color="#fff7c8" stop-opacity="0.2" />
          <stop offset="0.6" stop-color="#fff7c8" stop-opacity="0" />
        </radialGradient>
        <filter id="iso-patch" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="22" />
        </filter>
        <filter id="iso-cast" x="-40%" y="-40%" width="180%" height="180%" color-interpolation-filters="sRGB">
          <feColorMatrix type="matrix" values="0 0 0 0 0.17  0 0 0 0 0.25  0 0 0 0 0.08  0 0 0 0.24 0" />
          <feGaussianBlur stdDeviation="1.8" />
        </filter>
        <filter id="iso-soft" x="-40%" y="-80%" width="180%" height="260%">
          <feGaussianBlur stdDeviation="1.6" />
        </filter>
      </defs>

      {/* the field */}
      <rect x="-200" y="-200" width={W + 400} height={H + 400} fill="url(#iso-grass)" />
      <g filter="url(#iso-patch)">
        {patches.map((p) => (
          <ellipse cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} rx={p.rx.toFixed(1)} ry={p.ry.toFixed(1)} fill={p.light ? "#d2e88e" : "#8fb548"} opacity={p.light ? 0.35 : 0.22} />
        ))}
      </g>
      <rect x="-200" y="-200" width={W + 400} height={H + 400} fill="url(#iso-sun)" />
      {ground.map((d) => (
        <image href={`/terrain/decal-${d.src}.webp`} x={d.x.toFixed(1)} y={d.y.toFixed(1)} width={d.w.toFixed(1)} height={d.h.toFixed(1)} />
      ))}

      {/* back rope and posts */}
      <path class="iso-rope" d={sag(rope[3], rope[0]) + " " + sag(rope[0], rope[1])} />
      {[stakes[6], stakes[7], stakes[0], stakes[1], stakes[2]].map(([x, y]) => (
        <g>
          <polygon points={postShadow([x, y])} fill="#2d4316" opacity="0.18" filter="url(#iso-soft)" />
          <image href="/terrain/post.webp" x={x - POST.w / 2} y={y - POST.h} width={POST.w} height={POST.h} />
        </g>
      ))}

      {/* the block: shadow, near faces (lit left, shaded right) with the
          trench's ends cut through them */}
      <polygon points={pts(blockShadow)} fill="#2d4316" opacity="0.24" filter="url(#iso-soft)" />
      <polygon points={pts(faceLeft)} fill="url(#iso-face-l)" />
      <polygon points={pts(notchLeft)} fill="url(#iso-notch-l)" />
      <polygon points={pts(faceRight)} fill="url(#iso-face-r)" />
      <polygon points={pts(notchRight)} fill="url(#iso-notch-r)" />
      <polygon points={pts(faceRight)} fill="#2a1206" opacity="0.2" />
      <polygon points={pts(notchRight)} fill="#2a1206" opacity="0.2" />

      {/* the trench along the far sides: floor, then its outer walls */}
      <polygon points={pts(trench.map((p) => down(p, DB)))} fill="url(#iso-floor)" />
      <polygon points={pts(trench.map((p) => down(p, DB)))} fill="#3a1a08" opacity="0.18" />
      <polygon points={pts(wallNorth)} fill="url(#iso-wall-n)" />
      <polygon points={pts(wallWest)} fill="url(#iso-wall-w)" />
      <polygon points={pts(wallWest)} fill="#2a1206" opacity="0.22" />
      <path d={`M${pts([down(SW, DB), down(NW, DB), down(NE, DB)])}`} fill="none" stroke="#2a1206" stroke-width="1.4" opacity="0.35" />

      {/* the plot's turf, unbroken under the clear turf tiles */}
      <polygon points={pts(turf)} fill="url(#iso-grass)" />
      <g clip-path="url(#iso-plot)">
        <g filter="url(#iso-patch)">
          {plotPatches.map((p) => (
            <ellipse cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} rx={p.rx.toFixed(1)} ry={p.ry.toFixed(1)} fill={p.light ? "#d2e88e" : "#8fb548"} opacity={p.light ? 0.35 : 0.24} />
          ))}
        </g>
        {plotDecals.map((d) => (
          <image href={`/terrain/decal-${d.src}.webp`} x={d.x.toFixed(1)} y={d.y.toFixed(1)} width={d.w.toFixed(1)} height={d.h.toFixed(1)} />
        ))}
      </g>
      <g transform={PLANE}>
        <rect x={-E} y={-E - 5} width={600 + M + E} height="12" fill="url(#iso-lip-n)" />
        <rect x={-E - 5} y={-E} width="12" height={1000 + M + E} fill="url(#iso-lip-w)" />
        <rect x="0" y="-6" width={600 + M} height="9" fill="url(#iso-lip-s)" />
        <rect x="-6" y="0" width="9" height={1000 + M} fill="url(#iso-lip-e)" />
      </g>

      {/* ink outline round the block, as on the sheet */}
      <path
        d={`M${pts([SW, down(SW), down(SE), down(NE), NE])} M${pts([SE, down(SE)])}`}
        fill="none"
        stroke={INK}
        stroke-width="1.4"
        stroke-linejoin="round"
        stroke-linecap="round"
      />

      {/* the kit, each with its cast shadow */}
      {props.filter((p) => !p.baked).map((p) => (
        <image href={`/props/${p.src}.webp`} x={p.x} y={p.y} width={p.w} height={p.h} preserveAspectRatio="xMidYMax meet" transform={cast(p.y + p.h * p.footY, p.lift)} filter="url(#iso-cast)" />
      ))}
      {props.map((p) => (
        <image href={`/props/${p.src}.webp`} x={p.x} y={p.y} width={p.w} height={p.h} preserveAspectRatio="xMidYMax meet" />
      ))}
    </svg>
  ) : (
    <svg class={className} viewBox={`0 0 ${W.toFixed(1)} ${H.toFixed(1)}`} aria-hidden="true">
      {/* front rope and posts, nearer the viewer than the plot */}
      <path class="iso-rope" d={sag(rope[1], rope[2]) + " " + sag(rope[2], rope[3])} />
      {[stakes[3], stakes[4], stakes[5]].map(([x, y]) => (
        <g>
          <polygon points={postShadow([x, y])} fill="#2d4316" opacity="0.18" filter="url(#iso-soft)" />
          <image href="/terrain/post.webp" x={x - POST.w / 2} y={y - POST.h} width={POST.w} height={POST.h} />
        </g>
      ))}
    </svg>
  )
}
